{
  "name": "crypto-cta-manager-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:acquisition": "node --test tests/acquisitionAnalysis.test.mjs",
    "lint": "oxlint src vite.config.ts",
    "generate:nav-proto": "protoc -I ../src/web --plugin=protoc-gen-es=node_modules/.bin/protoc-gen-es --es_out=src/generated --es_opt=target=js+dts ../src/web/timeline.proto",
    "test:nav-proto": "node --test tests/timelineProto.test.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
