[Unit]
Description=Crypto CTA Manager dashboard API (jp-meta)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/crypto_cta_manager
EnvironmentFile=/home/ubuntu/.config/crypto-cta-manager/database.env
Environment=RUST_LOG=crypto_cta_manager=info,tower_http=info
ExecStart=/home/ubuntu/crypto_cta_manager/bin/cta_web --config /home/ubuntu/crypto_cta_manager/config/cta-manager.toml --bind 127.0.0.1:18201 --refresh-secs 60
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=default.target
