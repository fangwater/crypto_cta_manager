[Unit]
Description=Discard expired jp-meta Manager cold signals (operator-authorized)

[Service]
Type=oneshot
WorkingDirectory=%h/crypto_cta_manager
ExecStart=/usr/bin/python3 %h/crypto_cta_manager/scripts/prune_cold_signals.py --config %h/crypto_cta_manager/config/cta-manager.toml --binary %h/crypto_cta_manager/bin/cta_position_archive --expected-source-identity 71c586be-58f6-4cab-966b-e61b7902f5ec --max-segments 32 --max-seconds 45 --execute --discard-without-backup
Nice=19
IOSchedulingClass=idle
CPUAffinity=36
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
