[Unit]
Description=Crypto CTA Manager dashboard API
After=network-online.target postgresql-cta.service
Wants=network-online.target
Requires=postgresql-cta.service

[Service]
Type=simple
WorkingDirectory=/home/el01/crypto_cta_manager
EnvironmentFile=/home/el01/.config/crypto-cta-manager/database.env
Environment=RUST_LOG=crypto_cta_manager=info,tower_http=info
ExecStart=/home/el01/crypto_cta_manager/bin/cta_web --config /home/el01/crypto_cta_manager/config/cta-manager.toml --bind 127.0.0.1:18201 --refresh-secs 60
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=default.target
