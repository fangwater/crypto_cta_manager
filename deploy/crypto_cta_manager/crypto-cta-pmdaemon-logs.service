[Unit]
Description=Reclaim old blocks from selected Exec pmdaemon logs

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/crypto_cta_manager/scripts/maintain_pmdaemon_logs.py --log-dir %h/.pmdaemon/logs --file exec_pt_binance_exec_trade06-error.log --file exec_pt_binance_exec_trade07-error.log --max-mib 256 --keep-mib 16 --execute
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=30
MemoryMax=64M
NoNewPrivileges=true
UMask=0077
