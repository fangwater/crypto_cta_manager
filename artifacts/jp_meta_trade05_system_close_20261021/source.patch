+                            3,
+                            "BTCUSDC",
+                            1,
+                            2,
+                            100.0,
+                            1.0,
+                            "system_position_close",
+                        ),
+                        spot,
+                        strategy_event_at(5, 5, "BTCUSDT", 1, 1, 100.0, 1.0, "alpha"),
